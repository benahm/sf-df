{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OrgAlignResult",
  "definitions": {
    "OrgAlignResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dryRun": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AlignedFile"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkippedComponent"
          }
        },
        "unlistedTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "dryRun",
        "files",
        "skipped",
        "unlistedTypes"
      ]
    },
    "AlignedFile": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "changed",
            "deleted"
          ]
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RemovedEntry"
          }
        },
        "defaultApplication": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "fullName",
        "filePath",
        "status",
        "removed"
      ],
      "additionalProperties": false
    },
    "RemovedEntry": {
      "type": "object",
      "properties": {
        "section": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "section",
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    "SkippedComponent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missingObject",
            "unreadable",
            "noDefaultApplication"
          ]
        }
      },
      "required": [
        "type",
        "fullName",
        "filePath",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}