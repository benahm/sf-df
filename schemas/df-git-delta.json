{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DeltaResult",
  "definitions": {
    "DeltaResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "sourceDir": {
          "type": "string"
        },
        "packageDir": {
          "type": "string"
        },
        "destructiveDir": {
          "type": "string"
        },
        "packageManifestPath": {
          "type": "string"
        },
        "destructiveManifestPath": {
          "type": "string"
        },
        "processedChanges": {
          "type": "number"
        },
        "countsByStatus": {
          "type": "object",
          "properties": {
            "add": {
              "type": "number"
            },
            "modify": {
              "type": "number"
            },
            "delete": {
              "type": "number"
            },
            "rename": {
              "type": "number"
            }
          },
          "required": [
            "add",
            "modify",
            "delete",
            "rename"
          ],
          "additionalProperties": false
        },
        "countsByStrategy": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeltaComponent"
          }
        },
        "skippedFiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeltaSkippedFile"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "components",
        "countsByStatus",
        "countsByStrategy",
        "from",
        "packageDir",
        "packageManifestPath",
        "processedChanges",
        "skippedFiles",
        "sourceDir",
        "warnings"
      ]
    },
    "DeltaComponent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/definitions/DeltaComponentAction"
        },
        "manifest": {
          "type": "string",
          "enum": [
            "package",
            "destructive"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fullName": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "files",
        "fullName",
        "manifest",
        "type"
      ]
    },
    "DeltaComponentAction": {
      "type": "string",
      "enum": [
        "add",
        "modify",
        "rename",
        "delete",
        "deactivate"
      ]
    },
    "DeltaSkippedFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "forceignore",
            "no-change"
          ]
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}