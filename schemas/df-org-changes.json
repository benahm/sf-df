{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OrgChangesCommandResult",
  "definitions": {
    "OrgChangesCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputFile": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrgChange"
          }
        },
        "tracking": {
          "type": "boolean"
        },
        "unlistedTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "changes",
        "tracking",
        "unlistedTypes"
      ]
    },
    "OrgChange": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "lastModifiedDate": {
          "type": "string"
        },
        "lastModifiedById": {
          "type": "string"
        },
        "lastModifiedByName": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "changed",
            "deleted"
          ]
        },
        "source": {
          "$ref": "#/definitions/ChangeSource"
        }
      },
      "required": [
        "type",
        "fullName",
        "lastModifiedDate",
        "status",
        "source"
      ],
      "additionalProperties": false
    },
    "ChangeSource": {
      "type": "string",
      "enum": [
        "metadata",
        "tracking",
        "accesses"
      ]
    }
  }
}